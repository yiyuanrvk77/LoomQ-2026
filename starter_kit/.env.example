# Copy this file to .env for local development. Keep every credential empty in
# the committed template; .env itself is ignored by git.
LOOMQ_LLM_BASE_URL=
LOOMQ_LLM_API_KEY=
LOOMQ_LLM_MODEL=
LOOMQ_LLM_TIMEOUT_SECONDS=120
LOOMQ_LLM_MAX_OUTPUT_TOKENS=4096

# Reserved for optional, separate hardware-evidence connectors. adapter.run()
# does not read these values and never submits a QPU job.
LOOMQ_SPINQ_TOKEN=
LOOMQ_ORIGINQ_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
